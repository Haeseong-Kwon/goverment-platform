# --- 필수: Supabase (브라우저에 노출됨) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 선택: AI 진단 (서버 전용) ---
OPENROUTER_API_KEY=sk-or-v1-replace-with-server-secret
OPENROUTER_MODEL=z-ai/glm-5.2

# --- 선택: 기관 계정 부트스트랩 (서버 전용, 완제품 전 단계용) ---
# MANAGER_EMAILS에 적힌 계정만 /manager 화면에서 기관 계정으로 승격할 수 있습니다.
# 비워두면 /api/admin/bootstrap-manager 가 404로 완전히 꺼집니다.
# SUPABASE_SERVICE_ROLE_KEY는 RLS를 우회하므로 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
MANAGER_EMAILS=
MANAGER_INSTITUTION_NAME=기본 주관기관

# --- 선택: K-Startup 공고 자동 동기화 (서버 전용) ---
# 공공데이터포털에서 "창업진흥원_K-Startup(사업소개,사업공고,콘텐츠 등)_조회서비스"(15125364)
# 활용신청 후 발급받는 일반 인증키(Decoding)를 넣습니다. 무료·자동승인입니다.
# https://www.data.go.kr/data/15125364/openapi.do
DATA_GO_KR_API_KEY=
# /api/kstartup/sync 호출을 막는 공유 비밀. Vercel Cron이 Bearer 토큰으로 보냅니다.
# 비워 두면 동기화 라우트가 503으로 완전히 꺼집니다. 수동 실행:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<도메인>/api/kstartup/sync
CRON_SECRET=

# --- 개발용 진입 모드 (로컬 전용) ---
# 1로 두면 로그인 없이 워크스페이스/매니저 화면을 예시 데이터로 열 수 있습니다.
# production 빌드에서는 값과 무관하게 항상 꺼집니다.
NEXT_PUBLIC_DEV_BYPASS=

# --- 선택: 검색엔진 소유확인 (브라우저에 노출됨) ---
# 값이 비어 있으면 meta 태그 자체가 출력되지 않습니다.
# Google: Search Console > 속성 추가 > HTML 태그 방식의 content 값만 넣습니다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Naver: 서치어드바이저 > 사이트 등록 > HTML 태그의 content 값만 넣습니다.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# --- 선택: 트래킹 (브라우저에 노출됨, production 빌드에서만 동작) ---
# 값을 비워 두면 해당 스크립트를 아예 넣지 않습니다. 로컬·프리뷰 통계가 실측에 섞이지 않습니다.
# GA4: 관리 > 데이터 스트림 > 웹 스트림의 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# 네이버 애널리틱스: 사이트 등록 후 발급되는 계정 ID
NEXT_PUBLIC_NAVER_ANALYTICS_ID=
# Microsoft Clarity: 세션 리플레이·히트맵 (무료). 프로젝트 ID
NEXT_PUBLIC_CLARITY_ID=

# --- 선택: 색인 허용 (기본은 프로덕션 배포에서만 허용) ---
# Vercel 프리뷰는 본문이 같아 중복 색인이 되므로 자동으로 막습니다.
# 프로덕션이 아닌 곳에서 색인을 열어야 할 때만 1로 둡니다.
NEXT_PUBLIC_ALLOW_INDEXING=
