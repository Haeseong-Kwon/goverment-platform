# --- 필수: Supabase (브라우저에 노출됨) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 선택: AI 진단 (서버 전용) ---
OPENROUTER_API_KEY=sk-or-v1-replace-with-server-secret
OPENROUTER_MODEL=z-ai/glm-5.2

# --- 선택: 기관 계정 부트스트랩 (서버 전용, 완제품 전 단계용) ---
# MANAGER_EMAILS에 적힌 계정만 /manager 화면에서 기관 계정으로 승격할 수 있습니다.
# 비워두면 /api/admin/bootstrap-manager 가 404로 완전히 꺼집니다.
# SUPABASE_SERVICE_ROLE_KEY는 RLS를 우회하므로 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
MANAGER_EMAILS=
MANAGER_INSTITUTION_NAME=기본 주관기관

# --- 개발용 진입 모드 (로컬 전용) ---
# 1로 두면 로그인 없이 워크스페이스/매니저 화면을 예시 데이터로 열 수 있습니다.
# production 빌드에서는 값과 무관하게 항상 꺼집니다.
NEXT_PUBLIC_DEV_BYPASS=
